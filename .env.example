# Storage Configuration: 'database' (recommended for production CyberPanel) or 'json' (local file)
DATA_STORAGE=database

# MariaDB / MySQL Connection Configuration (CyberPanel / Production Host)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Server Port (CyberPanel Node.js App / Reverse Proxy)
PORT=3000

# Persistent Media Uploads Directory (keeps uploads outside build folder)
UPLOADS_DIR=

# GEMINI_API_KEY: Optional editorial AI assistant features
GEMINI_API_KEY=

# APP_URL: Canonical public website URL
APP_URL=

